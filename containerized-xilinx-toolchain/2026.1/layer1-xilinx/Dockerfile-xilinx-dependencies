# syntax=docker/dockerfile:latest

# Reference: requirements for Vivado and Vitis
# https://docs.amd.com/r/en-US/ug973-vivado-release-notes-install-license/Requirements-and-Setup

# Reference: requirements for Petalinux
# https://docs.amd.com/r/en-US/ug1144-petalinux-tools-reference-guide/Overview
#
# This dockerfile uses RUN with the --mount flag to minimize disk usage.
#
# Warning: this --mount flag does not accept variables unless using the
# syntax=docker/dockerfile:latest directive
#
# Warning 2: if receiving "# failed to compute cache key: not found: not found"
# errors, check that the mount location is not being captured by the
# .dockerignore file
#
# Note: Vivado/Vitis is NOT installed into this image. It is installed on
# the host at /tools/Xilinx (see the "install_vivado" Makefile target, which
# runs the installer through this image with /tools/Xilinx bind-mounted
# read-write) and bind-mounted back in read-only at runtime (see
# compose.yml). This image only provides the OS and the libraries the
# toolchain needs.

################################################################################

ARG BASE_IMAGE=base-u24
FROM ${BASE_IMAGE}

# BASE_IMAGE may already end as a non-root user (e.g. localhost/fpga_dev
# ends with "USER dev"). All RUN steps below need root, so reset
# unconditionally - a no-op for base-u24, which is already root.
USER root

# Labels
LABEL description="Image for Xilinx toolchain"

ARG GROUP_ID
ARG USER_ID
ARG USER_NAME
ARG XILINX_VERSION
ARG EXTEND_BASE=false
# Redeclare: ARGs declared before FROM aren't visible in RUN instructions
# after it unless redeclared here (only used below for a log message).
ARG BASE_IMAGE
ENV XILINX_VERSION=${XILINX_VERSION}

# Initial steps for Installation
RUN mkdir -p /tools/Xilinx

# Packages needed for Petalinux installation
# Acquired from 2025.1_petalinux_OS_Package_latest_list.xlsx
# https://adaptivesupport.amd.com/s/article/000037805?language=en_US
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y \
        autoconf \
        automake \
        bison \
        build-essential \
        chrpath \
        cpio \
        debianutils \
        diffstat \
        expect \
        flex \
        gawk \
        gcc \
        gcc-multilib \
        git \
        git-core \
        gnupg \
        gzip \
        iproute2 \
        iputils-ping \
        libegl1 \
        libglx-mesa0 \
        libncurses5-dev \
        libsdl1.2-dev \
        libselinux1 \
        libssl-dev \
        libtool \
        make \
        net-tools \
        pax \
        pylint \
        python-is-python3 \
        python3 \
        python3-git \
        python3-jinja2 \
        python3-pexpect \
        python3-pip \
        screen \
        socat \
        tar \
        texinfo \
        tftpd-hpa \
        unzip \
        wget \
        xterm \
        xz-utils \
        zlib1g-dev \
        zlib1g-dev \
        zlib1g:i386 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Extra packages needed and not stated anywhere :(
# libgtk-3 needed to fix "The Eclipse executable launcher no longer supports running with GTK + 2.x. Continuing using GTK+ 3.x."
# libidn11 needed to fix "/opt/Xilinx/Vitis/2022.1/tps/lnx64/cmake-3.3.2/bin/cmake: error while loading shared libraries: libidn.so.11: cannot open shared object file: No such file or directory"
# libidn11 reference: https://support.xilinx.com/s/question/0D52E00006jrzsYSAQ/platform-project-cannot-be-created-on-vitis?language=en_US
# dbus-x11 needed to fix VitisAI RPU flow error: SWT SessionManagerDBus: Failed to connect to org.gnome.SessionManager: Failed to execute child process “dbus-launch” (No such file or directory)
# dnsutils needed for Petalinux
# locales needed for Petalinux
# x11-utils needed for xlsclients (needed for vitis)
# lsb-release needed for vivado proper OS detection (also used by installLibs.sh)
RUN apt-get update && apt-get install -y \
    bc \
    libxtst6 \
    libxi6 \
    libgtk2.0-0 \
    locales \
    dnsutils \
    sudo \
    libgtk-3-dev \
    libidn12 \
    dbus-x11 \
    x11-utils \
    lsb-release \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# More packages needed for install
RUN --mount=type=bind,target=/temp,source=temp,rw \
    cd /temp && \
    # Fix CRLF line terminations
    sed -i 's/\r$//' installLibs.sh && \
    ./installLibs.sh && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Needed for Petalinux: /bin/bash: warning: setlocale: LC_ALL: cannot change locale (en_US.UTF-8)
RUN locale-gen en_US.UTF-8 && update-locale

# Point sh to bash instead of dash - Petalinux exepected bash instead of dash
# so it might be a good practice to change it still for Vivado/Vitis
RUN rm /bin/sh && ln -s /bin/bash /bin/sh

# Create user inside container (this avoids ERROR: Exiting Installer: Cannot install as root user !)
# It is common to see this being done in the "entrypoint.sh" but this container
# is meant to be built locally and not distribuited through
# nexus or other means due to its huge size.
# Thus we can create the user and set uid/gid during build process.
#
# When EXTEND_BASE=true, BASE_IMAGE already provides USER_NAME with matching
# UID/GID (e.g. localhost/fpga_dev's "dev" user) - skip re-creating it.
RUN if [ "${EXTEND_BASE}" != "true" ]; then \
        /usr/sbin/groupadd --gid ${GROUP_ID} ${USER_NAME} && \
        /usr/sbin/useradd --shell /bin/bash -u ${USER_ID} -g ${GROUP_ID} \
            --groups sudo -m ${USER_NAME} > /dev/null 2>&1 ; \
    else \
        echo "EXTEND_BASE=true: reusing ${USER_NAME} (uid=${USER_ID} gid=${GROUP_ID}) from ${BASE_IMAGE}" ; \
    fi

# Grant passwordless sudo at build time (while we're genuinely root) so the
# entrypoint never needs to run as root itself. That lets containers from
# this image be started with `--userns=keep-id`/`userns_mode: keep-id`,
# which runs the entrypoint directly as the host user and keeps anything it
# writes to host bind mounts (e.g. /tools/Xilinx during install) owned by
# the real host UID/GID instead of a subuid-mapped one.
RUN echo "${USER_NAME} ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Setup entrypoint
COPY layer1-xilinx/entrypoint-xilinx.sh /entrypoint-xilinx.sh

# Run as the (created or inherited) non-root user by default. Without this,
# the image's default user stays root (from the unconditional "USER root"
# above), and `userns_mode: keep-id` alone does NOT change which user the
# container starts as - it only controls how that user's UID/GID map onto
# the host. Root inside + keep-id would map container UID 0 to some host
# subuid, not to the invoking host user, which is why builds with
# EXTEND_BASE=true (image built at 1000:1000, no host UID/GID passed at
# runtime) were showing up as root instead of the host user.
USER ${USER_NAME}

ENTRYPOINT ["/entrypoint-xilinx.sh"]
